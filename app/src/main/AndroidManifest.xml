<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
            android:allowBackup="true"
            android:dataExtractionRules="@xml/data_extraction_rules"
            android:fullBackupContent="@xml/backup_rules"
            android:label="@string/app_name"
            android:supportsRtl="true"
            android:theme="@style/Theme.ChelasMultiPlayerPokerDice"
            android:name="pt.isel.pdm.configuration.RealConfiguration"
            android:networkSecurityConfig="@xml/network_security_config">
        <service
            android:name="pt.isel.pdm.match.foreGround.MatchForegroundService"
            android:foregroundServiceType="dataSync"
            android:exported="false"
            android:launchMode="singleTop">
        </service>
        <activity
                android:name="pt.isel.pdm.MainActivity"
                android:exported="true"
                android:label="@string/app_name"
                android:theme="@style/Theme.ChelasMultiPlayerPokerDice">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>

                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
    </application>

</manifest>